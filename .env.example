# LLM provider selection (OpenAI-compatible protocol)
# "auto" = use DeepSeek unless OPENAI_API_KEY is set, then use OpenAI.
# You can also force a vendor: LUMINA_LLM_PROVIDER=deepseek|openai
LUMINA_LLM_PROVIDER=auto

# DeepSeek API configuration
# Copy this file to .env and fill in your key. Never commit .env.

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI / any OpenAI-compatible vendor (used when provider is "openai")
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_PLANNER_MODEL=gpt-4o

# Planner: reasoner makes the plan, flash executes (optional)
LUMINA_ENABLE_PLANNER=false
DEEPSEEK_PLANNER_MODEL=deepseek-reasoner
LUMINA_PLANNER_MAX_TOKENS=4096

# Agent behavior
LUMINA_MAX_ITERATIONS=20
LUMINA_MAX_TOKENS=8192
# Per-run cost guard. 0 disables the budget (and disables context compression by
# budget). Each /message call gets a fresh budget.
LUMINA_TOKEN_BUDGET=0
LUMINA_TEMPERATURE=0.3
LUMINA_MAX_AUTO_FIX_ROUNDS=3

# Context window reported in the UI's session usage popup. Set to your model's
# real context length so the usage ring and compression behave consistently.
LUMINA_CONTEXT_LIMIT=131072

# Context compression: summarize early history once cumulative tokens reach
# (LUMINA_TOKEN_BUDGET * LUMINA_COMPRESS_AT), keeping the last N messages verbatim.
LUMINA_COMPRESSION=true
LUMINA_COMPRESS_AT=0.6
LUMINA_COMPRESS_KEEP=10

# Self-review: verify the final answer against the task; continue fixing if gaps are found.
LUMINA_SELF_REVIEW=true

# Additional workspaces for the web/desktop UI (comma-separated absolute paths).
# You can also manage them from the UI's workspace picker.
LUMINA_WORKSPACES=

# Security
LUMINA_DANGER_COMMANDS=rm -rf,git push,git push --force,git reset --hard,git clean,drop database
LUMINA_SAFE_COMMANDS=pytest,ruff,python,git status,git diff,git log,ls,dir,pip install

# Optional password for the Web UI / desktop UI (HTTP basic-like auth).
# When set (or when `lumina web --password <pw>` is used), browsers must log in
# before using the app; the password itself is never stored.
# LUMINA_WEB_PASSWORD=changeme

# Multimodal image input in the Web UI. Requires a vision-capable model
# (e.g. OpenAI-compatible vision endpoint). DeepSeek does NOT support images,
# so leave this off with DeepSeek or image requests will be rejected.
LUMINA_VISION=false
